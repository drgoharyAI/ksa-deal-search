{
  "name": "web-search-deals",
  "version": "0.1.0",
  "private": true,
  "description": "Search eight Saudi online stores at once, with rule-based matching, cross-store grouping, deal badges, price history and Telegram price alerts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drgoharyAI/ksa-deal-search.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "lint:strict": "eslint -c eslint.strict.config.mjs",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "qa": "npm run lint && npm run lint:strict && npm run typecheck && npm test && npm run knip",
    "test": "vitest run",
    "predev": "node scripts/install-specs.mjs",
    "prestart": "node scripts/install-specs.mjs"
  },
  "dependencies": {
    "api-anything": "^0.5.0",
    "next": "16.4.6",
    "p-limit": "^7.3.3",
    "playwright-core": "^1.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-redos": "^4.6.2",
    "eslint-plugin-security": "^4.2.1",
    "knip": "^6.48.0",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
