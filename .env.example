# Copy to .env on the server (never commit .env). docker compose reads it (env_file).

# Hosts the browser may use to reach the app, comma-separated host[:port], matched exactly.
# Loopback is always allowed. Add the LAN host name too if you use one (and Caddy: the bare name).
APP_HOSTS=192.168.1.48:3000

# Telegram price alerts (optional). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hours between price-alert checks (default 6, minimum 0.25).
ALERT_CHECK_HOURS=6

NODE_ENV=production

# Only with the "https" compose profile: the LAN name Caddy serves.
# CADDY_HOST=deals.lan

# Optional: the IPv4 address the ports bind to (default 0.0.0.0, IPv4 only; never IPv6).
# APP_BIND=192.168.1.48

# Optional Cloudflare Tunnel (public hostname). Add the hostname to APP_HOSTS too.
# COMPOSE_PROFILES=tunnel
# Put the tunnel token in a separate .env.tunnel (chmod 600), never here: TUNNEL_TOKEN=...
